{
	"name": "@runa-cmd/create",
	"version": "0.2.0-beta.4",
	"description": "Create a CLI made with Runa: npm create @runa-cmd my-tool",
	"license": "MIT",
	"type": "module",
	"keywords": [
		"cli",
		"create",
		"scaffold",
		"template",
		"runa"
	],
	"bin": {
		"create": "./dist/index.js"
	},
	"scripts": {
		"build": "tsc && node scripts/copy-template.mjs",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --dir src",
		"lint": "biome check .",
		"clean": "rm -rf dist template"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/jrodrigopuca/runa-cmd.git",
		"directory": "packages/create"
	},
	"homepage": "https://github.com/jrodrigopuca/runa-cmd/tree/main/packages/create#readme",
	"bugs": {
		"url": "https://github.com/jrodrigopuca/runa-cmd/issues"
	},
	"files": [
		"dist",
		"template",
		"README.md",
		"CHANGELOG.md"
	],
	"devDependencies": {
		"@runa-cmd/core": "workspace:*",
		"@types/node": "^25.6.0",
		"typescript": "^6.0.2",
		"zod": "^4.3.6"
	}
}
