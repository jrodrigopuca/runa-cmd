// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`generateBashCompletions > matches snapshot 1`] = `
"#!/usr/bin/env bash
# Bash completions for mycli
# Generated by @runa-cmd/completions

_mycli_completions() {
    local cur="\${COMP_WORDS[COMP_CWORD]}"
    local prev="\${COMP_WORDS[COMP_CWORD-1]}"

    # Build the command path from COMP_WORDS, past positionals and values
    local paths=" _deploy _config _config_set _config_get "
    local value_flags=" --format --environment -e --replicas "
    local cmd_path=""
    local skip=0
    local i=1
    while [[ $i -lt $COMP_CWORD ]]; do
        local word="\${COMP_WORDS[i]}"
        if [[ $skip -eq 1 ]]; then
            skip=0
        elif [[ "$word" == -* ]]; then
            [[ "$word" != *=* && "$value_flags" == *" $word "* ]] && skip=1
        elif [[ "$paths" == *" \${cmd_path}_\${word} "* ]]; then
            cmd_path="\${cmd_path}_\${word}"
        fi
        ((i++))
    done

    case "$cmd_path" in
        "")
            case "$prev" in
            --format)
                COMPREPLY=($(compgen -W 'json text table' -- "$cur"))
                return ;;
            esac
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W '--help -h --verbose -v --format' -- "$cur"))
            else
                COMPREPLY=($(compgen -W 'deploy config' -- "$cur"))
            fi
            ;;
        "_deploy")
            case "$prev" in
            --environment|-e)
                COMPREPLY=($(compgen -W 'staging prod' -- "$cur"))
                return ;;
            --format)
                COMPREPLY=($(compgen -W 'json text table' -- "$cur"))
                return ;;
            esac
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W '--environment -e --force --replicas --help -h --verbose -v --format' -- "$cur"))
            fi
            ;;
        "_config")
            case "$prev" in
            --format)
                COMPREPLY=($(compgen -W 'json text table' -- "$cur"))
                return ;;
            esac
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W '--help -h --verbose -v --format' -- "$cur"))
            else
                COMPREPLY=($(compgen -W 'set get' -- "$cur"))
            fi
            ;;
        "_config_set")
            case "$prev" in
            --format)
                COMPREPLY=($(compgen -W 'json text table' -- "$cur"))
                return ;;
            esac
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W '--global -g --help -h --verbose -v --format' -- "$cur"))
            fi
            ;;
        "_config_get")
            case "$prev" in
            --format)
                COMPREPLY=($(compgen -W 'json text table' -- "$cur"))
                return ;;
            esac
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W '--help -h --verbose -v --format' -- "$cur"))
            fi
            ;;
    esac
}
complete -F _mycli_completions mycli"
`;
